{
  "manifest_version": 3,
  "name": "ClauseRadar",
  "short_name": "ClauseRadar",
  "version": "0.1.0",
  "description": "Classify regulatory clause impact and compare document versions, right from your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open ClauseRadar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.workers.dev/*"
  ],
  "commands": {
    "classify-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Open ClauseRadar and classify selected text"
    }
  }
}
